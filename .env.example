# Application Mode: all | api | worker
APP_MODE=all
APP_ENV=development
LOG_LEVEL=info

# HTTP Server
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/notifications?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_AUTO_MIGRATE=true

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# External Webhook Provider (replace with your https://webhook.site/{uuid} URL)
WEBHOOK_URL=http://localhost:8081/webhook
WEBHOOK_TIMEOUT=10s

# Per-Channel Rate Limits (messages per second, max 100 per requirement)
RATE_LIMIT_SMS=100
RATE_LIMIT_EMAIL=100
RATE_LIMIT_PUSH=100

# Worker & Retry Settings
WORKERS_PER_CHANNEL=8
MAX_RETRY_ATTEMPTS=5
RETRY_BASE_BACKOFF=1s
RETRY_MAX_BACKOFF=60s
OUTBOX_POLL_INTERVAL=100ms
OUTBOX_BATCH_SIZE=100
SCHEDULER_POLL_INTERVAL=1s
RETRY_PROMOTER_INTERVAL=250ms
PROCESSING_LEASE_DURATION=60s

# Circuit Breaker Settings
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN=15s
CB_HALF_OPEN_MAX_PROBES=2

# OpenTelemetry Tracing (noop | stdout | otlp)
OTEL_EXPORTER=noop
OTEL_SERVICE_NAME=notification-service
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
